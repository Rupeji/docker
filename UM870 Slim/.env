ini
# =========================================================================
# CONFIGURACIÓN DE RED LOCAL ACTUALIZADA (NUEVO RANGO DEL ROUTER)
# =========================================================================
IP_PRINCIPAL=192.168.50.150
IP_LANCACHE=192.168.50.151

# =========================================================================
# CREDENCIALES DE ADGUARD HOME (CAMBIAR TRAS EL SETUP INICIAL)
# =========================================================================
ADGUARD_USER=tu_usuario_adguard
ADGUARD_PASS=tu_password_adguard

# =========================================================================
# CONFIGURACIÓN DE RENDIMIENTO Y ALMACENAMIENTO (R7 8745H + WD BLUE 4TB)
# =========================================================================
# Asignamos 2000m (2GB) de los 16GB DDR5 para la caché en RAM de LanCache
LANCACHE_RAM=2000m
# Límite de seguridad para que Jellyfin y el sistema no se queden sin espacio
LANCACHE_DISCO_MINIMO=50g
# Punto de montaje de la piscina LVM2 del SSD de 4TB
RUTA_SSD_4TB=/mnt/storage_4tb
